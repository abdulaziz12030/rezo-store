# REZO STYLE — local / Vercel server environment
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REZO_STYLE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_REZO_STYLE_SERVICE_ROLE_ONLY

# First Owner bootstrap
# No extra Vercel setup token is required. /admin-setup is locked to style@rezo.sa,
# works only while REZO STYLE has no admin/auth users, and requires email confirmation.

# Supabase Edge Functions secrets (set in the REZO STYLE project only)
MOYASAR_SECRET_KEY=sk_test_REPLACE_ME
REZO_STYLE_PUBLIC_URL=https://style.example.com

# Security boundaries
# Never place a Moyasar secret key or service-role key in a NEXT_PUBLIC_* variable.
# Never reuse or copy environment values from REZO LASH into this repository automatically.
